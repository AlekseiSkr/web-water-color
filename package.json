{
  "name": "watercolor-timelapse",
  "version": "0.1.0",
  "description": "Stroke-planned, seeded watercolor painting engine for React, Vue, and vanilla JavaScript.",
  "type": "module",
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" },
    "./vue": { "types": "./dist/vue.d.ts", "import": "./dist/vue.js" }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "build:pages": "vite build --config vite.pages.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "vue": { "optional": true }
  },
  "dependencies": {
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "react": "^19.1.1",
    "vue": "^3.5.18"
  }
}
